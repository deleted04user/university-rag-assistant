# Copier vers .env et adapter
# Si uvicorn échoue sur le port 8000 (WinError 10013), lancer avec --port 8001
# ou exécuter : .\run_api.ps1
#
# RAG local (Phase A) — sans API
# RAG_ENABLED=true
# RAG_MIN_SIMILARITY=0.38
# RAG_INDEX_PATH=./rag_index.joblib
DATABASE_URL=sqlite:///./university.db
# PostgreSQL (après docker compose up) :
# DATABASE_URL=postgresql://univ:univ@127.0.0.1:5432/univ
SECRET_KEY=remplacer-par-une-cle-longue-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,null
